NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://ahla_user:ahla_pass@localhost:5432/ahla_shabab

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# Push notifications (Firebase Cloud Messaging)
#
# ⚠️ FCM_SERVER_KEY IS RETIRED AND IGNORED. A "server key" authenticates the
# legacy FCM HTTP API, which Google deprecated in June 2023 and SHUT DOWN on
# 20 June 2024. Row 49 of the delivery matrix sat BLOCKED waiting for this key —
# a credential that would not have worked on arrival. The app logs a warning at
# boot if it is set.
FCM_SERVER_KEY=
#
# What push actually needs: a service account, from
# Firebase console → Project settings → Service accounts → Generate new private
# key. Either the JSON inline, or a path to the file. Keep it out of the repo.
#
# With neither set, push is DISABLED and says so once at boot. Notifications
# still reach the in-app feed; they just don't reach a phone.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Email (OTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@ahlashabab.com
EMAIL_PROVIDER_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# OTP
OTP_TTL=10m
OTP_LENGTH=6

# SMS (optional)
SMS_PROVIDER_KEY=
SMS_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Reverse proxies in front of this process
#
# REQUIRED IN PRODUCTION. The rate limiter buckets by `request.ip`, and so does
# the `ip` column of the admin activity log. Express only reads that from
# X-Forwarded-For when the proxy chain is trusted — otherwise it is the socket
# peer, which behind a proxy is THE SAME ADDRESS FOR EVERY VISITOR.
#
# That was this deployment's state (Cloudflare + nginx, setting absent), which
# meant one global bucket: 100 requests a minute for the entire platform, 5 admin
# login attempts per 10 minutes shared by every administrator — one person
# mistyping a password locked out the whole foundation — and 5 OTP requests per
# 10 minutes for the whole mobile user base.
#
# Set it to the NUMBER OF PROXIES that rewrite X-Forwarded-For, counting from
# this process outward. Cloudflare in front of nginx in front of Node is 2.
# Verify against the nginx config before choosing: too high is its own bug,
# because a caller can then write the header themselves and skip the limits.
#
# `false` (the default) keeps the old behaviour. `true` trusts the whole chain
# and is spoofable — use a hop count instead. A comma-separated list of
# addresses/CIDRs, or `loopback`, also works.
TRUST_PROXY=false

# Redis (for BullMQ jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# Payment webhook (POST /webhooks/payment)
#
# Required in production: the app REFUSES TO BOOT with NODE_ENV=production unless
# WEBHOOK_SECRET is set and at least 16 characters. The endpoint can mark a
# donation paid, so it verifies an HMAC-SHA256 digest of the raw JSON body sent
# in the x-webhook-signature header.
WEBHOOK_SECRET=

# Local-only escape hatch: accept UNSIGNED webhook calls when no WEBHOOK_SECRET
# is configured. Without this the endpoint returns 503, which is the safe default.
# Ignored in production — it cannot be used to weaken a deployed environment.
ALLOW_UNSIGNED_WEBHOOKS=false

# First administrator account
#
# The seed used to hash a hardcoded password, in a PUBLIC repository, and
# `deploy.yml` runs the seed on every push — so the live «مدير عام» account, with
# every permission over donations, beneficiaries and national IDs, had a password
# anyone could read off GitHub.
#
# Now: an existing admin is NEVER touched (no password reset, no reactivation of
# a disabled account), and no admin is created unless a password is supplied
# here. In production, a missing value means no account is created — loudly.
# Outside production a random one is generated and printed once.
#
# Set it once on a fresh deployment, run the seed, then change the password
# through POST /api/v1/admin/auth/change-password and remove it from the file.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@ahlashabab.com

# Seeding (prisma db seed)
#
# deploy.yml runs the seed on EVERY push to main. Leave this false/unset: the
# seed then CREATES rows that are missing and LEAVES EXISTING ONES ALONE, so
# content authored in the dashboard CMS — and any role whose permissions an admin
# has tightened — survives a deploy.
#
# Set to true only for a deliberate one-off push of bundled defaults over live
# rows. It is destructive: it resets the whole CMS document, role permissions,
# category/service/provider/FAQ/stat text, and provider ratings.
SEED_OVERWRITE_CONTENT=false
