NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://ahla_user:ahla_pass@localhost:5432/ahla_shabab

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Email (OTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@ahlashabab.com
EMAIL_PROVIDER_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# OTP
OTP_TTL=10m
OTP_LENGTH=6

# SMS (optional)
SMS_PROVIDER_KEY=
SMS_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Redis (for BullMQ jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# Payment webhook (POST /webhooks/payment)
#
# Required in production: the app REFUSES TO BOOT with NODE_ENV=production unless
# WEBHOOK_SECRET is set and at least 16 characters. The endpoint can mark a
# donation paid, so it verifies an HMAC-SHA256 digest of the raw JSON body sent
# in the x-webhook-signature header.
WEBHOOK_SECRET=

# Local-only escape hatch: accept UNSIGNED webhook calls when no WEBHOOK_SECRET
# is configured. Without this the endpoint returns 503, which is the safe default.
# Ignored in production — it cannot be used to weaken a deployed environment.
ALLOW_UNSIGNED_WEBHOOKS=false
