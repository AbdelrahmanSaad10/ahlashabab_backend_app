generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// REFERENCE DATA
// ============================================================

model Governorate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users                 User[]
  bookings              Booking[]
  volunteerApplications VolunteerApplication[]
  workAreas             WorkArea[]

  @@map("governorates")
}

model WorkArea {
  id            Int         @id @default(autoincrement())
  governorateId Int         @unique @map("governorate_id")
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  active        Boolean     @default(true)
  sortOrder     Int         @default(0) @map("sort_order")

  @@map("work_areas")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  phone         String?
  governorateId Int?         @map("governorate_id")
  governorate   Governorate? @relation(fields: [governorateId], references: [id])
  bio           String?
  isGuest       Boolean      @default(false) @map("is_guest")
  blocked       Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  bookings             Booking[]
  donations            Donation[]
  favorites            Favorite[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  deviceTokens         DeviceToken[]
  consultationRequests ConsultationRequest[]
  refreshTokens        RefreshToken[]           @relation("UserRefreshTokens")

  @@map("users")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  providerId   String?   @unique @map("provider_id")
  provider     Provider? @relation(fields: [providerId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[] @relation("AdminRefreshTokens")

  @@map("admin_users")
}

model Role {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  permissionsJson Json     @map("permissions_json")
  createdAt       DateTime @default(now()) @map("created_at")

  adminUsers AdminUser[]

  @@map("roles")
}

model RefreshToken {
  id          String     @id @default(uuid())
  token       String     @unique
  userId      String?    @map("user_id")
  user        User?      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?    @map("admin_user_id")
  adminUser   AdminUser? @relation("AdminRefreshTokens", fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime   @map("expires_at")
  revoked     Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([token])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, code])
  @@map("otp_codes")
}

// ============================================================
// CATALOG & PROVIDERS
// ============================================================

model ServiceCategory {
  id          String            @id @default(uuid())
  name        String
  icon        String?
  description String?
  parentId    String?           @map("parent_id")
  parent      ServiceCategory?  @relation("CategoryNesting", fields: [parentId], references: [id])
  children    ServiceCategory[] @relation("CategoryNesting")
  active      Boolean           @default(true)
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Provider {
  id                String   @id @default(uuid())
  name              String
  specialization    String?
  type              String?
  bio               String?
  yearsExperience   Int?     @map("years_experience")
  sessions          Int      @default(0)
  rating            Float?   @default(0)
  reviews           Int?     @default(0)
  avatarUrl         String?  @map("avatar_url")
  featured          Boolean  @default(false)
  active            Boolean  @default(true)
  acceptingBookings Boolean  @default(true) @map("accepting_bookings")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  schedules            ProviderSchedule[]
  unavailableDates     ProviderUnavailableDate[]
  services             Service[]
  bookings             Booking[]
  adminUser            AdminUser?
  consultationRequests ConsultationRequest[]

  @@map("providers")
}

model ProviderSchedule {
  id          String   @id @default(uuid())
  providerId  String   @map("provider_id")
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  weekday     Int
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  slotMinutes Int      @map("slot_minutes")

  @@unique([providerId, weekday])
  @@map("provider_schedules")
}

model ProviderUnavailableDate {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  @@unique([providerId, date])
  @@map("provider_unavailable_dates")
}

model Service {
  id                String          @id @default(uuid())
  name              String
  description       String?
  categoryId        String          @map("category_id")
  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  providerId        String          @map("provider_id")
  provider          Provider        @relation(fields: [providerId], references: [id])
  free              Boolean         @default(true)
  requireNationalId Boolean         @default(false) @map("require_national_id")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  formFields ServiceFormField[]
  bookings   Booking[]

  @@map("services")
}

model ServiceFormField {
  id          String  @id @default(uuid())
  serviceId   String  @map("service_id")
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String
  required    Boolean @default(false)
  hidden      Boolean @default(false)
  optionsJson Json?   @map("options_json")
  sortOrder   Int     @default(0) @map("sort_order")

  @@unique([serviceId, key])
  @@map("service_form_fields")
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id              String       @id @default(uuid())
  reference       String       @unique
  serviceId       String       @map("service_id")
  service         Service      @relation(fields: [serviceId], references: [id])
  providerId      String       @map("provider_id")
  provider        Provider     @relation(fields: [providerId], references: [id])
  userId          String?      @map("user_id")
  user            User?        @relation(fields: [userId], references: [id])
  applicantName   String       @map("applicant_name")
  phone           String
  age             Int?
  gender          String?
  governorateId   Int?         @map("governorate_id")
  governorate     Governorate? @relation(fields: [governorateId], references: [id])
  city            String?
  nationalId      String?      @map("national_id")
  notes           String?
  date            DateTime     @db.Date
  timeSlot        String       @map("time_slot")
  timeSlotLabel   String?      @map("time_slot_label")
  status          String       @default("قيد الانتظار")
  extraFieldsJson Json?        @map("extra_fields_json")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([reference])
  @@index([userId])
  @@index([status])
  @@index([providerId, date])
  @@map("bookings")
}

// ============================================================
// DONATIONS
// ============================================================

model Donation {
  id          String   @id @default(uuid())
  reference   String   @unique
  donorName   String   @map("donor_name")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  cause       String
  /// What the donation was given for. `cause` is the free-text label on the
  /// receipt; these are the actual links, and what `raisedAmount` derives from.
  /// Optional — a general donation belongs to neither.
  caseId      String?  @map("case_id")
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount      Int
  method      String
  recurring   Boolean  @default(false)
  status      String   @default("قيد التأكيد")
  gatewayTxId String?  @unique @map("gateway_tx_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([reference])
  @@map("donations")
}

// ============================================================
// PORTFOLIO
// ============================================================

model PortfolioItem {
  id           String    @id @default(uuid())
  type         String
  title        String
  description  String?
  governorate  String?
  date         DateTime? @db.Date
  published    Boolean   @default(false)
  coverUrl     String?   @map("cover_url")
  body         String?
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([type, published])
  @@map("portfolio_items")
}

model Case {
  id                  String   @id @default(uuid())
  code                String   @unique
  title               String
  location            String?
  summary             String?
  need                String?
  tag                 String?
  verified            Boolean  @default(false)
  targetAmount        Int?     @map("target_amount")
  raisedAmount        Int      @default(0) @map("raised_amount")
  supporters          Int      @default(0)
  coverUrl            String?  @map("cover_url")
  sponsorable         Boolean  @default(false)
  monthlyAmount       Int?     @map("monthly_amount")
  sponsorshipDuration String?  @map("sponsorship_duration")
  sponsorshipStatus   String?  @map("sponsorship_status")
  published           Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  updates  CaseUpdate[]
  donations Donation[]

  @@index([tag])
  @@map("cases")
}

model CaseUpdate {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  text      String
  kind      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("case_updates")
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String?
  status       String?
  category     String?
  timeline     String?
  targetAmount Int?     @map("target_amount")
  raisedAmount Int      @default(0) @map("raised_amount")
  supporters   Int      @default(0)
  coverUrl     String?  @map("cover_url")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stages    ProjectStage[]
  updates   ProjectUpdate[]
  donations Donation[]

  @@map("projects")
}

model ProjectStage {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("project_stages")
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  kind      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_updates")
}

// ============================================================
// FOUNDATION CONTENT
// ============================================================

model FoundationStat {
  id        String  @id @default(uuid())
  key       String  @unique
  value     String
  label     String
  icon      String?
  sortOrder Int     @default(0) @map("sort_order")

  @@map("foundation_stats")
}

model Milestone {
  id          String  @id @default(uuid())
  year        Int
  title       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("milestones")
}

model FoundationValue {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("foundation_values")
}

model Initiative {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?
  coverUrl    String? @map("cover_url")
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("initiatives")
}

model Consultant {
  id             String  @id @default(uuid())
  name           String
  specialization String?
  bio            String?
  avatarUrl      String? @map("avatar_url")
  active         Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order")

  @@map("consultants")
}

// ============================================================
// ENGAGEMENT & CONTENT
// ============================================================

model Article {
  id          String   @id @default(uuid())
  category    String
  title       String
  excerpt     String?
  body        String?
  date        DateTime @db.Date
  location    String?
  readMinutes Int?     @map("read_minutes")
  coverUrl    String?  @map("cover_url")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, published])
  @@map("articles")
}

model VolunteerApplication {
  id            String       @id @default(uuid())
  name          String
  phone         String
  age           Int?
  governorateId Int?         @map("governorate_id")
  governorate   Governorate? @relation(fields: [governorateId], references: [id])
  interestsJson Json?        @map("interests_json")
  availability  String?
  status        String       @default("جديد")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("volunteer_applications")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  message   String
  status    String   @default("جديد")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model ConsultationRequest {
  id               String    @id @default(uuid())
  reference        String    @unique
  userId           String?   @map("user_id")
  user             User?     @relation(fields: [userId], references: [id])
  type             String
  name             String
  phone            String
  whatsapp         String?
  email            String
  age              Int?
  governorate      String?
  preferredChannel String?   @map("preferred_channel")
  preferredTime    String?   @map("preferred_time")
  summary          String?
  extraFieldsJson  Json?     @map("extra_fields_json")
  providerId       String?   @map("provider_id")
  date             DateTime?
  timeSlot         String?   @map("time_slot")
  provider         Provider? @relation(fields: [providerId], references: [id])
  status           String    @default("جديد")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([userId])
  @@map("consultation_requests")
}

model Faq {
  id        String  @id @default(uuid())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  published Boolean @default(true)

  @@map("faqs")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("notifications")
}

model NotificationPreference {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key     String
  enabled Boolean @default(true)

  @@unique([userId, key])
  @@map("notification_preferences")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_tokens")
}

model Favorite {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  @@unique([userId, entityType, entityId])
  @@map("favorites")
}

// ============================================================
// HEADLESS CMS
// ============================================================

model CmsState {
  id                 Int      @id @default(1)
  schemaVersion      Int      @map("schema_version")
  settingsJson       Json     @map("settings_json")
  menuJson           Json     @map("menu_json")
  homeJson           Json     @map("home_json")
  pagesJson          Json     @map("pages_json")
  paymentMethodsJson Json     @map("payment_methods_json")
  consultationsJson  Json     @map("consultations_json")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("cms_state")
}

model CmsMedia {
  id        String   @id @default(uuid())
  title     String?
  alt       String?
  caption   String?
  folder    String?
  srcUrl    String   @map("src_url")
  type      String
  width     Int?
  height    Int?
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_media")
}

// ============================================================
// ADMIN & AUDIT
// ============================================================

model ActivityLog {
  id            String    @id @default(uuid())
  actorId       String    @map("actor_id")
  actor         AdminUser @relation(fields: [actorId], references: [id])
  action        String
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  previousValue Json?     @map("previous_value")
  newValue      Json?     @map("new_value")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_log")
}
